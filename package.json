{
  "name": "ground-track",
  "version": "0.1.0",
  "private": true,
  "description": "A satellite game where the flight computer solves the orbit and you supply the last number.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node scripts/shots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "gates": "node scripts/gates.mjs",
    "palette": "node scripts/gates/palette.mjs",
    "shots:diff": "node scripts/gates/shots-diff.mjs",
    "accent": "node scripts/gates/accent.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "eslint": "^9.16.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
